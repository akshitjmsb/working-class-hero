{
  "name": "working-class-hero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "tsx scripts/migrate.ts --on-deploy && tsx scripts/intelligence-migrate.ts --on-deploy && next build --webpack && tsx scripts/seed.ts --on-deploy",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:resume-sync": "node --import tsx --test tests/resume-sync-*.test.ts",
    "test:matching": "node --import tsx --test tests/job-matching.test.ts tests/resume-sync-profile.test.ts",
    "validate": "tsx scripts/validate-data.ts",
    "check:links": "tsx scripts/check-links.ts",
    "roles:refresh": "tsx scripts/refresh-roles.ts",
    "ats:discover": "tsx scripts/discover-ats.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:studio": "drizzle-kit studio",
    "system": "tsx scripts/intelligence.ts",
    "system:mcp": "tsx scripts/intelligence-mcp.ts",
    "system:migrate": "tsx scripts/intelligence-migrate.ts",
    "test:system": "node --import tsx --test tests/intelligence*.test.ts",
    "system:flush": "tsx scripts/intelligence-maintenance.ts flush",
    "system:status": "tsx scripts/intelligence-maintenance.ts status",
    "system:backup": "tsx scripts/intelligence-maintenance.ts backup",
    "system:verify-backup": "tsx scripts/intelligence-maintenance.ts verify-backup",
    "system:restore": "tsx scripts/intelligence-maintenance.ts restore"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.9",
    "@deck.gl/layers": "^9.3.9",
    "@deck.gl/mapbox": "^9.3.9",
    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/canvas": "^0.1.100",
    "@neondatabase/serverless": "^1.1.0",
    "@serwist/next": "^9.5.12",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.1",
    "h3-js": "^4.1.0",
    "maplibre-gl": "^4.7.1",
    "next": "16.3.0",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^7.1.7",
    "serwist": "^9.5.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^20.16.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
